<Window x:Class="Ra2.Vampire.Config.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="尤里扩展 · 功能配置器 - Ra2.Vampire.Config"
        Height="680" Width="620"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI, Microsoft YaHei UI">
    <Grid>
        <!-- ===== 动态背景：流动渐变 + 环境光晕 ===== -->
        <Grid>
            <Rectangle IsHitTestVisible="False">
                <Rectangle.Fill>
                    <LinearGradientBrush x:Name="BgBrush" StartPoint="0,0" EndPoint="1,1">
                        <GradientStop x:Name="BgStop1" Color="#FF0A0A12" Offset="0"/>
                        <GradientStop x:Name="BgStop2" Color="#FF1A0A2E" Offset="0.5"/>
                        <GradientStop x:Name="BgStop3" Color="#FF0A0A12" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
                <Rectangle.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="BgStop2"
                                                 Storyboard.TargetProperty="Offset"
                                                 From="0.2" To="0.8" Duration="0:0:9"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Rectangle.Triggers>
            </Rectangle>

            <Ellipse Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top"
                     Margin="-100,-120,0,0" IsHitTestVisible="False" Opacity="0.18">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FF6A0DAD" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                     Margin="0,0,-140,-160" IsHitTestVisible="False" Opacity="0.16">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#FFD0021B" Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Triggers>
                    <EventTrigger RoutedEvent="Loaded">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                 From="0.08" To="0.22" Duration="0:0:6"
                                                 AutoReverse="True" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Ellipse.Triggers>
            </Ellipse>
        </Grid>

        <!-- ===== 标题栏 ===== -->
        <Border Height="56" VerticalAlignment="Top" Background="#CC0A0A12"
                BorderBrush="#22B048E8" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="24,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="⬢" FontSize="22" Foreground="{StaticResource YuriPurpleLightBrush}"
                               Margin="0,0,10,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="LogoRotate" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LogoRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:14"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <TextBlock Text="尤里扩展 · 功能配置器" FontSize="16" FontWeight="Black"
                               Foreground="White" VerticalAlignment="Center">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="10"
                                              ShadowDepth="0" Opacity="0.9"/>
                        </TextBlock.Effect>
                    </TextBlock>
                </StackPanel>
                <Button x:Name="BtnClose" Width="36" Height="36" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SovietButton}" Content="✕" FontSize="13" Padding="0"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- ===== 主内容 ===== -->
        <Grid Margin="24,72,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 功能开关面板 -->
            <Border Grid.Row="0" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                    Background="#CC141420" BorderBrush="{StaticResource YuriPurpleDarkBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="14"
                                      ShadowDepth="0" Opacity="0.4"/>
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="◆" FontSize="14" Foreground="{StaticResource YuriPurpleLightBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="功能开关" FontWeight="Black" FontSize="13"
                                   Foreground="{StaticResource YuriPurpleLightBrush}"/>
                        <TextBlock Text="（写入同目录 Ra2.Vampire.Extend.ini，DLL 启动时读取）" FontSize="10"
                                   Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- 开关1：间谍自偷 -->
                    <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,8"
                            Background="#FF0A0A12" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🕵" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="间谍自偷" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="允许间谍渗透己方 Spyable 建筑" FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="ToggleSelfSteal" Style="{StaticResource YuriToggle}"
                                      VerticalAlignment="Center"
                                      Checked="ToggleSelfSteal_Checked" Unchecked="ToggleSelfSteal_Unchecked"/>
                        </Grid>
                    </Border>

                    <!-- 开关2：超时空下车空气墙修复 -->
                    <Border CornerRadius="6" Padding="14,10"
                            Background="#FF0A0A12" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="⚡" FontSize="20" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="超时空下车空气墙修复" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock Text="阻止 Teleport 步兵下车残留幽灵空气墙" FontSize="10"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                            <CheckBox Grid.Column="2" x:Name="ToggleChronoAirWall" Style="{StaticResource YuriToggle}"
                                      VerticalAlignment="Center"
                                      Checked="ToggleChronoAirWall_Checked" Unchecked="ToggleChronoAirWall_Unchecked"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 操作按钮 -->
            <Grid Grid.Row="1" Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="BtnLoad" Style="{StaticResource SovietButton}"
                        Content="读取配置" Height="40" Margin="0,0,7,0" Click="BtnLoad_Click"/>
                <Button Grid.Column="1" x:Name="BtnSave" Style="{StaticResource YuriButton}"
                        Content="保存配置" Height="40" Margin="7,0,0,0" Click="BtnSave_Click"/>
            </Grid>

            <!-- 日志区 -->
            <Border Grid.Row="2" CornerRadius="8" Padding="0" ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Color="#CC0A0A12"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="#33B048E8"/>
                </Border.BorderBrush>
                <Border.BorderThickness>
                    <Thickness>1</Thickness>
                </Border.BorderThickness>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#22141020" Padding="14,8">
                        <TextBlock Text="■ 操作日志" FontWeight="Bold" FontSize="11"
                                   Foreground="{StaticResource YuriPurpleLightBrush}"/>
                    </Border>
                    <TextBox Grid.Row="1" x:Name="LogBox" IsReadOnly="True" BorderThickness="0"
                             Background="Transparent" Foreground="#FFB0B0C0" FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="11" Padding="14,8" VerticalScrollBarVisibility="Auto"
                             TextWrapping="Wrap" CaretBrush="{StaticResource YuriPurpleLightBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- ===== 成功遮罩 ===== -->
        <Border x:Name="SuccessOverlay" Visibility="Collapsed" Background="#A6000000">
            <Border x:Name="SuccessCard" Width="340" Padding="28,24" CornerRadius="14"
                    Background="#FF141420" BorderBrush="{StaticResource YuriPurpleLightBrush}" BorderThickness="2"
                    HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform x:Name="SuccessScale" ScaleX="0.7" ScaleY="0.7"/>
                    </TransformGroup>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="30"
                                      ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="✓" FontSize="44" Foreground="{StaticResource YuriPurpleLightBrush}"
                               HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="20"
                                              ShadowDepth="0" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock x:Name="SuccessTitle" Text="配置已保存" FontWeight="Black" FontSize="18"
                               Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SuccessMsg" Text="" FontSize="12"
                               Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center"
                               TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
