<Window x:Class="Ra2.Vampire.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Ra2.Vampire.UI"
        mc:Ignorable="d"
        Title="尤里补丁部署器 - Yuri Patch Deployer"
        Height="620" Width="780"
        WindowStyle="None"
        ResizeMode="CanMinimize"
        Background="{StaticResource BgDarkBrush}"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <Window.Resources>
        <!-- 扫描线动画的网格 -->
        <LinearGradientBrush x:Key="ScanLineBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="Transparent" Offset="0"/>
            <GradientStop Color="#66B048E8" Offset="0.5"/>
            <GradientStop Color="Transparent" Offset="1"/>
        </LinearGradientBrush>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- 背景径向渐变光晕 -->
        <Grid.Background>
            <RadialGradientBrush GradientOrigin="0.5,0.3" Center="0.5,0.5" RadiusX="0.8" RadiusY="0.8">
                <GradientStop Color="#FF1A0A2E" Offset="0"/>
                <GradientStop Color="#FF0A0A12" Offset="1"/>
            </RadialGradientBrush>
        </Grid.Background>

        <!-- 顶部标题栏 -->
        <Border x:Name="TitleBar" Height="56" VerticalAlignment="Top"
                Background="#CC1A0A2E" BorderBrush="{StaticResource YuriPurpleBrush}" 
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 标志 + 标题 -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="☣" FontSize="28" Foreground="{StaticResource YuriPurpleLightBrush}"
                               Margin="0,0,12,0" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform>
                            <RotateTransform x:Name="LogoRotate" Angle="0"/>
                        </TextBlock.RenderTransform>
                        <TextBlock.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="LogoRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360" Duration="0:0:12"
                                                         RepeatBehavior="Forever"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </TextBlock.Triggers>
                    </TextBlock>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="YURI PATCH DEPLOYER" FontSize="18" FontWeight="Black"
                                   Foreground="{StaticResource YuriPurpleLightBrush}"
                                   FontFamily="Segoe UI, Microsoft YaHei UI">
                            <TextBlock.Effect>
                                <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="12" 
                                                  ShadowDepth="0" Opacity="0.9"/>
                            </TextBlock.Effect>
                        </TextBlock>
                        <TextBlock Text="尤里复仇 · 补丁部署系统 v1.0" FontSize="11"
                                   Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- 最小化按钮 -->
                <Button x:Name="BtnMin" Grid.Column="1" Width="36" Height="36" Margin="4,0"
                        Style="{StaticResource YuriButton}" Content="—" FontSize="14"
                        Click="BtnMin_Click"/>
                <!-- 关闭按钮 -->
                <Button x:Name="BtnClose" Grid.Column="2" Width="36" Height="36" Margin="4,10,10,10"
                        Style="{StaticResource SovietButton}" Content="✕" FontSize="14"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <!-- 主内容区 -->
        <Grid Margin="24,70,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 路径选择区 -->
            <Border Grid.Row="0" CornerRadius="8" Padding="16,14" Margin="0,0,0,14"
                    Background="#CC141420" BorderBrush="{StaticResource YuriPurpleDarkBrush}" 
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="16" 
                                      ShadowDepth="0" Opacity="0.5"/>
                </Border.Effect>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="目标路径" FontWeight="Bold"
                               Foreground="{StaticResource YuriPurpleLightBrush}" 
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox x:Name="PathBox" Grid.Row="0" Grid.Column="1" Height="34"
                             Background="#FF0A0A12" Foreground="{StaticResource TextBrush}"
                             BorderBrush="{StaticResource YuriPurpleDarkBrush}" 
                             BorderThickness="1" CaretBrush="{StaticResource YuriPurpleLightBrush}"
                             VerticalContentAlignment="Center" Padding="8,0" FontSize="13"
                             IsReadOnly="True" Text="请选择游戏目录..."/>
                    <Button x:Name="BtnBrowse" Grid.Row="0" Grid.Column="2" Style="{StaticResource YuriButton}"
                            Content="浏览..." Width="90" Height="34" Margin="10,0,0,0"
                            Click="BtnBrowse_Click"/>

                    <TextBlock x:Name="PathHint" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
                               Text="提示：请选择包含 gamemd.exe 和 Ares.dll 的尤里复仇游戏目录"
                               FontSize="11" Foreground="{StaticResource TextDimBrush}"
                               Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- 检测状态区 -->
            <Border Grid.Row="1" CornerRadius="8" Padding="14" Margin="0,0,0,14"
                    Background="#CC141420" BorderBrush="{StaticResource YuriPurpleDarkBrush}" 
                    BorderThickness="1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Ares.dll 检测 -->
                    <Border Grid.Column="0" CornerRadius="6" Padding="10" Margin="0,0,6,0"
                            Background="#FF0A0A12" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconAres" Text="○" FontSize="22" 
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="IconAresScale" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="Ares.dll" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="StatusAres" Text="未检测" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- gamemd.exe 检测 -->
                    <Border Grid.Column="1" CornerRadius="6" Padding="10" Margin="6,0,0,0"
                            Background="#FF0A0A12" BorderBrush="#22FFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="IconGame" Text="○" FontSize="22"
                                       Foreground="{StaticResource TextDimBrush}" Margin="0,0,10,0"
                                       RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <ScaleTransform x:Name="IconGameScale" ScaleX="1" ScaleY="1"/>
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="gamemd.exe" FontWeight="Bold" FontSize="13"
                                           Foreground="{StaticResource TextBrush}"/>
                                <TextBlock x:Name="StatusGame" Text="未检测" FontSize="11"
                                           Foreground="{StaticResource TextDimBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 日志输出区 -->
            <Border Grid.Row="2" CornerRadius="8" Padding="0" ClipToBounds="True">
                <Border.Background>
                    <SolidColorBrush Color="#CC0A0A12"/>
                </Border.Background>
                <Border.BorderBrush>
                    <SolidColorBrush Color="{StaticResource YuriPurpleDark}"/>
                </Border.BorderBrush>
                <Grid>
                    <!-- 扫描线动画 -->
                    <Rectangle x:Name="ScanLine" Height="60" VerticalAlignment="Top"
                               Fill="{StaticResource ScanLineBrush}" IsHitTestVisible="False"
                               Opacity="0.6">
                        <Rectangle.RenderTransform>
                            <TranslateTransform x:Name="ScanLineTransform" Y="0"/>
                        </Rectangle.RenderTransform>
                    </Rectangle>

                    <TextBox x:Name="LogBox" Margin="2" Background="Transparent"
                             Foreground="#FFB0FFC7" FontFamily="Consolas, Microsoft YaHei UI"
                             FontSize="12" BorderThickness="0" IsReadOnly="True"
                             VerticalScrollBarVisibility="Auto" TextWrapping="Wrap"
                             Padding="12,10" CaretBrush="{StaticResource YuriPurpleLightBrush}"/>
                </Grid>
            </Border>

            <!-- 底部操作区 -->
            <Grid Grid.Row="3" Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- 进度条 -->
                <Border Grid.Column="0" Height="10" CornerRadius="5" Margin="0,0,14,0"
                         Background="#FF1A1A2E" VerticalAlignment="Center"
                         BorderBrush="{StaticResource YuriPurpleDarkBrush}" BorderThickness="1">
                    <Grid>
                        <Rectangle x:Name="ProgressBar" HorizontalAlignment="Left" Width="0" 
                                   RadiusX="4" RadiusY="4">
                            <Rectangle.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{StaticResource YuriPurple}" Offset="0"/>
                                    <GradientStop Color="{StaticResource YuriPurpleLight}" Offset="0.5"/>
                                    <GradientStop Color="{StaticResource SovietRed}" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                            <Rectangle.Effect>
                                <DropShadowEffect Color="{StaticResource YuriPurpleLight}" 
                                                  BlurRadius="10" ShadowDepth="0" Opacity="0.8"/>
                            </Rectangle.Effect>
                        </Rectangle>
                    </Grid>
                </Border>

                <Button x:Name="BtnApply" Grid.Column="1" Style="{StaticResource YuriButton}"
                        Content="⚡ 应用补丁" Width="140" Height="40" FontSize="14"
                        Click="BtnApply_Click" IsEnabled="False"/>
            </Grid>
        </Grid>

        <!-- 全屏遮罩（用于动画提示） -->
        <Border x:Name="Overlay" Visibility="Collapsed" Background="#AA000000"
                IsHitTestVisible="False">
            <Border x:Name="OverlayCard" CornerRadius="12" Padding="40,30" Width="360"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF141420" BorderBrush="{StaticResource YuriPurpleLightBrush}"
                    BorderThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                    <ScaleTransform x:Name="OverlayScale" ScaleX="0.7" ScaleY="0.7"/>
                </Border.RenderTransform>
                <Border.Effect>
                    <DropShadowEffect Color="{StaticResource YuriPurple}" BlurRadius="30"
                                      ShadowDepth="0" Opacity="0.9"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <TextBlock x:Name="OverlayIcon" Text="⚠" FontSize="56" 
                               HorizontalAlignment="Center" Foreground="{StaticResource WarnYellowBrush}"
                               Margin="0,0,0,12"/>
                    <TextBlock x:Name="OverlayTitle" Text="提示" FontSize="20" FontWeight="Black"
                               HorizontalAlignment="Center" Foreground="{StaticResource TextBrush}"
                               Margin="0,0,0,10"/>
                    <TextBlock x:Name="OverlayMsg" Text="" FontSize="13" TextAlignment="Center"
                               Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap"
                               MaxWidth="280"/>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</Window>
